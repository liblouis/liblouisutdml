# MathML semantics for Russian mathematical Braille.
#
# Structural PUA characters follow the formatter contract implemented by
# Liblouis' ru-math.uti. They preserve distinctions that plain Unicode can
# not express, while ru-litbrl.ctb remains responsible for letters, numbers
# and mathematical symbols.
#
# Licensed under LGPLv3+.

namespaces math=http://www.w3.org/1998/Math/MathML

math math \xf32e,\*\xf32f
generic semantics
generic mstyle

# Periodic decimal notation is a single semantic unit: the digits in the
# parenthesized period do not restart numeric mode.
russianperiodicdecimal &xpath(//math:mn[contains(.,'(') and contains(.,')') and contains(.,',')])
russianperiodicdecimal &xpath(//math:mrow[count(*)=4][math:mn[1][contains(.,',')]][math:mo[1][normalize-space(.)='(']][math:mn[2][string-length(.)>0 and translate(.,'0123456789','')='']][math:mo[2][normalize-space(.)=')']])

# Both spellings with and without an invisible multiplication operator occur
# in MathML generated by common equation editors.
russianmixednumber &xpath(//math:mrow[count(*)=2][math:mn[1][string-length(.)>0 and translate(.,'0123456789','')='']][math:mfrac[1]])
russianmixednumber &xpath(//math:mrow[count(*)=3][math:mn[1][string-length(.)>0 and translate(.,'0123456789','')='']][math:mo[1][normalize-space(.)='⁢' or normalize-space(.)='⁤']][math:mfrac[1]])

# Function names defined in sections 2.9 and 2.10 are indivisible signs.
russianfunction &xpath(//math:mi[contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))])
russianfunction &xpath(//math:mtext[contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))])
russianfunction &xpath(//math:mo[contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))])
russianfunctionstructure &xpath(//math:msub[count(*)=2][*[1][self::math:mi or self::math:mtext or self::math:mo][contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))]])
russianfunctionstructure &xpath(//math:msup[count(*)=2][*[1][self::math:mi or self::math:mtext or self::math:mo][contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))]])
russianfunctionargument &xpath(//math:mi[string-length(.)>0 and translate(.,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz','')=''][preceding-sibling::*[1][self::math:mi or self::math:mtext or self::math:mo][contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))]])
russianfunctionargument &xpath(//math:mi[string-length(.)>0 and translate(.,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz','')=''][preceding-sibling::*[1][self::math:msub or self::math:msup or self::math:munder][*[1][self::math:mi or self::math:mtext or self::math:mo][contains('|sin|cos|tg|ctg|arcsin|arccos|arctg|arcctg|log|lg|ln|max|min|exp|lim|',concat('|',normalize-space(.),'|'))]]])
russianfunctionargument &xpath(//math:mi[string-length(.)>0 and translate(.,'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz','')=''][preceding-sibling::*[1][self::math:mo][contains('∠△⌒∥∈∉⊂⊄∩∪∖⇒⇐⇔∀∃',normalize-space(.))]])

# Geometry prefixes renew the Latin alphabet sign before the designation.
russiangeometryprefix &xpath(//math:mo[normalize-space(.)='∠' or normalize-space(.)='△' or normalize-space(.)='⌒'][following-sibling::*[1][self::math:mi]])
russiangeometryrelation &xpath(//math:mo[normalize-space(.)='∥' or normalize-space(.)='⊥' or normalize-space(.)='⟂' or normalize-space(.)='∼'])
russiansetoperator &xpath(//math:mo[contains('∈∉⊂⊄∩∪∖∅⇒⇐⇔∀∃',normalize-space(.))][string-length(normalize-space(.))=1])
russiansetoperator &xpath(//math:mo[normalize-space(.)='⁢'][preceding-sibling::*[1][self::math:mfrac] or following-sibling::*[1][self::math:mfrac]])

generic mi \es
generic mn \es
generic mo \es
generic mtext
generic ms
generic mrow

# An ordinary numeric fraction uses one number sign and lowered denominator
# digits. Other fractions use the explicit opening, horizontal bar and closing
# structure. Classification is local and does not depend on MathCAT.
russianfraction mfrac

# Bracket recognition is contextual. The C handlers inspect both neighbours
# of each bracket and then apply a recognition point to both members of a pair
# whenever either member is ambiguous.
russianfenced mfenced
russianrecognizedbracket &xpath(//math:mrow[*[1][self::math:mo and (normalize-space(.)='[' or normalize-space(.)='⟨' or normalize-space(.)='<')]][*[last()][self::math:mo and (normalize-space(.)=']' or normalize-space(.)='⟩' or normalize-space(.)='>')]]/math:mo[1])
russianrecognizedbracket &xpath(//math:mrow[*[1][self::math:mo and (normalize-space(.)='[' or normalize-space(.)='⟨' or normalize-space(.)='<')]][*[last()][self::math:mo and (normalize-space(.)=']' or normalize-space(.)='⟩' or normalize-space(.)='>')]]/math:mo[last()])

# Integer right scripts use lowered digits without a number sign or terminator.
# A combined lower/upper script has one common terminator after both indices.
# Marks encoded as scripts must be classified before ordinary indices. This
# list is deliberately closed: arbitrary mo indices (notably infinity) are
# indices, not marks.
russianmark &xpath(//math:msub[count(*)=2][*[2][self::math:mo and string-length(normalize-space(.))>0 and translate(normalize-space(.),'~_*+^-\u2212―¯′∗×○□ˇ→⟶←⟵','')='']])
russianmark &xpath(//math:msup[count(*)=2][*[2][self::math:mo and string-length(normalize-space(.))>0 and translate(normalize-space(.),'~_*+^-\u2212―¯′∗×○□ˇ→⟶←⟵','')='']])
russianintegerstructure &xpath(//math:msub[count(*)=2][*[2][self::math:mo or self::math:mi][normalize-space(.)='∞']])
russianintegerstructure &xpath(//math:msup[count(*)=2][*[2][self::math:mo or self::math:mi][normalize-space(.)='∞']])
russianintegerstructure &xpath(//math:msub[count(*)=2][*[2][self::math:mn and string-length(.)>0 and translate(.,'0123456789','')='']])
russianintegerstructure &xpath(//math:msup[count(*)=2][*[2][self::math:mn and string-length(.)>0 and translate(.,'0123456789','')='']])
msub msub ,\xf320,\xf402\xf320
msup msup ,\xf321,\xf402\xf321
msubsup msubsup ,\xf320,\xf321,\xf402\xf321

# MathML stores a root's radicand before its index. The reverse action emits
# the index first, as required by Russian linear mathematical Braille.
msqrt msqrt \xf32a\xf402\xf321,\*\xf32b
russianintegerstructure &xpath(//math:mroot[count(*)=2][*[2][self::math:mn and string-length(.)>0 and translate(.,'0123456789','')='']])
reverse mroot \xf32a,\xf402\xf321,\xf32b

# Content exactly below or above an expression.
russianmark &xpath(//math:munder[count(*)=2][*[2][self::math:mo]])
russianmark &xpath(//math:mover[count(*)=2][*[2][self::math:mo]])
munder munder ,\xf322,\xf402\xf322
mover mover ,\xf323,\xf402\xf323
munderover munderover ,\xf322,\xf402\xf322\xf323,\xf402\xf323

generic none
generic mprescripts
russianmmultiscripts mmultiscripts

# MathML hard line breaks distinguish a break at a print-space position from
# a break inside an unspaced mathematical sequence.
generic &xpath(//math:mspace[@linebreak='newline'][@width='0' or @width='0em']) \xf506
generic &xpath(//math:mspace[@linebreak='newline'][not(@width='0' or @width='0em')]) \xf507
generic mspace
generic &xpath(//math:mo[@linebreak='newline'][(@lspace='0' or @lspace='0em') and (@rspace='0' or @rspace='0em')]) \*\xf506
generic &xpath(//math:mo[@linebreak='newline'][not((@lspace='0' or @lspace='0em') and (@rspace='0' or @rspace='0em'))]) \*\xf507

# The mathematical punctuation separator (dot 6)
# precedes punctuation inside or at the end of mathematics. Do not insert it
# for a decimal comma split across MathML tokens or for a comma after ellipsis.
generic &xpath(//math:mo[string-length(normalize-space(.))=1][contains('.,;:!?',normalize-space(.))][not(normalize-space(.)=',' and preceding-sibling::*[1][self::math:mn] and following-sibling::*[1][self::math:mn])][not(normalize-space(.)=',' and preceding-sibling::*[1][self::math:mo and (normalize-space(.)='…' or normalize-space(.)='...')])]) \xf328,\*
generic &xpath(//math:mo[@linebreak='newline'][string-length(normalize-space(.))=1][contains('.,;:!?',normalize-space(.))][(@lspace='0' or @lspace='0em') and (@rspace='0' or @rspace='0em')]) \xf328,\*\xf506
generic &xpath(//math:mo[@linebreak='newline'][string-length(normalize-space(.))=1][contains('.,;:!?',normalize-space(.))][not((@lspace='0' or @lspace='0em') and (@rspace='0' or @rspace='0em'))]) \xf328,\*\xf507

# Typeface signs follow the current Liblouis implementation. They are paired
# around the affected MathML token or style span.
generic mi,mathvariant,italic \xf590,\*\xf590
generic mi,mathvariant,bold \xf591,\*\xf591
generic mi,mathvariant,bold-italic \xf591\xf590,\*\xf590\xf591
generic mn,mathvariant,italic \xf590,\*\xf590
generic mn,mathvariant,bold \xf591,\*\xf591
generic mn,mathvariant,bold-italic \xf591\xf590,\*\xf590\xf591
generic mo,mathvariant,italic \xf590,\*\xf590
generic mo,mathvariant,bold \xf591,\*\xf591
generic mo,mathvariant,bold-italic \xf591\xf590,\*\xf590\xf591
generic mtext,mathvariant,italic \xf590,\*\xf590
generic mtext,mathvariant,bold \xf591,\*\xf591
generic mtext,mathvariant,bold-italic \xf591\xf590,\*\xf590\xf591
generic ms,mathvariant,italic \xf590,\*\xf590
generic ms,mathvariant,bold \xf591,\*\xf591
generic ms,mathvariant,bold-italic \xf591\xf590,\*\xf590\xf591
generic mstyle,mathvariant,italic \xf590,\*\xf590
generic mstyle,mathvariant,bold \xf591,\*\xf591
generic mstyle,mathvariant,bold-italic \xf591\xf590,\*\xf590\xf591

matrix mtable
mtd mtd \*\ec
# Joining frames are opt-in because ordinary MathML tables also represent
# matrices and aligned equations. A legacy "joining" value means a left
# frame. Exactly one blank separates the brace from the joined row.
generic &xpath(//math:mtable[@data-braille-frame='joining' or @data-braille-frame='joining-left' or contains(@intent,':joining-frame-left') or contains(@intent,':joining-frame')]/math:mtr[count(../math:mtr)=1]) \xf570\x0020,\*\er
generic &xpath(//math:mtable[@data-braille-frame='joining' or @data-braille-frame='joining-left' or contains(@intent,':joining-frame-left') or contains(@intent,':joining-frame')]/math:mtr[position()=1 and count(../math:mtr)>1]) \xf572\x0020,\*\er
generic &xpath(//math:mtable[@data-braille-frame='joining' or @data-braille-frame='joining-left' or contains(@intent,':joining-frame-left') or contains(@intent,':joining-frame')]/math:mtr[position()>1 and position()<last()]) \xf573\x0020,\*\er
generic &xpath(//math:mtable[@data-braille-frame='joining' or @data-braille-frame='joining-left' or contains(@intent,':joining-frame-left') or contains(@intent,':joining-frame')]/math:mtr[position()=last() and position()>1]) \xf574\x0020,\*\er
generic &xpath(//math:mtable[@data-braille-frame='joining-right' or contains(@intent,':joining-frame-right')]/math:mtr[count(../math:mtr)=1]) \*\x0020\xf571\er
generic &xpath(//math:mtable[@data-braille-frame='joining-right' or contains(@intent,':joining-frame-right')]/math:mtr[position()=1 and count(../math:mtr)>1]) \*\x0020\xf575\er
generic &xpath(//math:mtable[@data-braille-frame='joining-right' or contains(@intent,':joining-frame-right')]/math:mtr[position()>1 and position()<last()]) \*\x0020\xf576\er
generic &xpath(//math:mtable[@data-braille-frame='joining-right' or contains(@intent,':joining-frame-right')]/math:mtr[position()=last() and position()>1]) \*\x0020\xf577\er
mtr mtr \*\er

# Standard MathML 4 vertical-layout elements. Their C handlers emit the same
# row/column contract as mtable, so the normal matrix formatter produces real
# braille lines.
russianmathstack mstack
russianlongdivision mlongdiv
generic msrow
generic msgroup
generic msline
generic mscarries
generic mscarry

# In column arithmetic and long division the number sign occurs only on the
# first line.  Subsequent integer tokens therefore use unnumbered digits.
russiancontinuednumber &xpath(//math:mtable[@data-braille-layout='column-arithmetic' or @data-braille-layout='long-division' or contains(@intent,':column-arithmetic') or contains(@intent,':long-division')]/math:mtr[position()>1]//math:mn[string-length(.)>0 and translate(.,'0123456789','')=''])
russiancontinuednumber &xpath(//math:mstack/*[position()>1]//math:mn[string-length(.)>0 and translate(.,'0123456789','')=''])
russiancontinuednumber &xpath(//math:mlongdiv/*[position()>3]//math:mn[string-length(.)>0 and translate(.,'0123456789','')=''])
russiancontinuednumber &xpath(//math:mlongdiv/math:mstack/*[position()>1]//math:mn[string-length(.)>0 and translate(.,'0123456789','')=''])

skip annotation
skip annotation-xml
skip merror
skip mphantom
no math,display
no math,display,block
no math,display,inline
no math,xmlns
no mfenced,close
no mfenced,open
no mfenced,separators
no mi,mathvariant
no mstyle,mathvariant
no mn,mathvariant
no mo,mathvariant
no mtext,mathvariant
no ms,mathvariant
no mover,accent
no munder,accentunder
no munderover,accent
no munderover,accentunder
